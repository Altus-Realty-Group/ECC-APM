run = "npm run start:replit"
modules = ["nodejs-20"]
hidden = [".cache", ".vite", "dist", "node_modules", "snapshots", ".archive"]

[packager]
install = "npm ci --no-audit --no-fund"

[packager.features]
guessImports = false

[[ports]]
localPort = 5000
externalPort = 80

[workflows]
runButton = "ECC-APM"

[[workflows.workflow]]
name = "ECC-APM"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run start:replit"
waitForPort = 5000
